{
  "manifest_version": 3,
  "name": "Media Grabber",
  "version": "0.4.0",
  "description": "Détecte les fichiers vidéo/audio chargés par la page et permet de les télécharger (HLS inclus).",
  "permissions": [
    "webRequest",
    "downloads",
    "storage",
    "tabs",
    "declarativeNetRequest",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Media Grabber"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "media-grabber@example.org",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
